# Firebase web configuration (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only: billing APIs, webhook entitlements)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional server-only enrichment for live India-wide search.
# Without this key, the app uses attributed Wikipedia summaries.
# Google Places may require billing in the operator's Google Cloud project.
# Never prefix this value with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# SaaS billing (server-only except the display label)
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Optional: pin to the API version configured for your Stripe integration.
STRIPE_API_VERSION=
NEXT_PUBLIC_PRO_PRICE_LABEL="Set in Stripe"

# Optional guardrail for server-side Firestore directory scans.
COLLEGE_QUERY_SCAN_LIMIT=250

# Maximum cutoff documents inspected per predictor request (1-2000).
PREDICTOR_QUERY_LIMIT=500

# Optional local paths used only by trusted Admin SDK import scripts.
# Keep service-account credentials outside Git.
COLLEGE_DATA_PATH=
CUTOFF_DATA_PATH=
DIRECTORY_DATA_PATH=
DIRECTORY_SOURCE_URL=
DIRECTORY_SOURCE_AUTHORITY=AISHE
DIRECTORY_SOURCE_YEAR=
